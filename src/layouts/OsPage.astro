---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getDesktopProps } from '../lib/os/tree-data';
import Desktop from '../components/os/Desktop.svelte';
import wallpaperSrc from '../assets/wallpaper.jpg';
import finderIcon from '../assets/dock/finder.png';
import notesIcon from '../assets/dock/notes.png';
import photosIcon from '../assets/dock/photos.png';
import previewIcon from '../assets/dock/preview.png';
import mailIcon from '../assets/dock/mail.png';
import githubIcon from '../assets/dock/github.svg';
import trashIcon from '../assets/dock/trash.png';
import { PERSON } from '../lib/seo';
import '../styles/global.css';

interface Props {
  initialPath?: string | null;
  title: string;
  description: string;
  ogImage?: string | null;
  notFound?: boolean;
  jsonLd?: Record<string, unknown> | null;
  ogType?: 'website' | 'profile' | 'article';
}

const {
  initialPath = null,
  title,
  description,
  ogImage = null,
  notFound = false,
  jsonLd = null,
  ogType = 'website',
} = Astro.props;

const { tree, showResume } = await getDesktopProps();
const wallpaper = await getImage({
  src: wallpaperSrc,
  format: 'webp',
  width: 2560,
  quality: 72,
});

// Real app icons for the dock (PNGs extracted from macOS; GitHub's official
// mark as SVG). webp keeps the alpha channel.
const dockIcon = (src: ImageMetadata) =>
  getImage({ src, format: 'webp', width: 128 });
const [finderI, notesI, photosI, previewI, mailI, trashI] = await Promise.all(
  [finderIcon, notesIcon, photosIcon, previewIcon, mailIcon, trashIcon].map(dockIcon)
);
const dockIcons = {
  finder: finderI.src,
  notes: notesI.src,
  photos: photosI.src,
  preview: previewI.src,
  mail: mailI.src,
  github: githubIcon.src,
  trash: trashI.src,
};
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : null;
const canonicalHref = canonicalUrl?.href ?? null;
const absolute = (path: string) =>
  Astro.site ? new URL(path, Astro.site).href : path;
// Pages without their own image fall back to the intro video (public/intro.mp4:
// "derek yao" writing itself, then blooming into the wallpaper) with its last
// frame (public/og.jpg) as the thumbnail, so shared links always preview the site.
const effectiveOgImage = ogImage ?? `${base}/og.jpg`;
const ogImageAbsolute = absolute(effectiveOgImage);
const ogVideoAbsolute = ogImage ? null : absolute(`${base}/intro.mp4`);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Hides the static page below once the desktop is going to run. Set
         before first paint so JS visitors never see it flash. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta
      name="google-site-verification"
      content="QLLgUfDMQJ-kVpywEdAo9US8p4P8AfZdppLnNUUtetg"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={PERSON.name} />
    {PERSON.sameAs.map((href) => <link rel="me" href={href} />)}
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}/favicon-96x96.png`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />

    <meta property="og:site_name" content="Derek Yao" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {canonicalHref && <meta property="og:url" content={canonicalHref} />}
    <meta property="og:image" content={ogImageAbsolute} />
    {
      ogVideoAbsolute && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:video" content={ogVideoAbsolute} />
          <meta property="og:video:secure_url" content={ogVideoAbsolute} />
          <meta property="og:video:type" content="video/mp4" />
          <meta property="og:video:width" content="1280" />
          <meta property="og:video:height" content="720" />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageAbsolute} />
    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({ '@context': 'https://schema.org', ...jsonLd })}
        />
      )
    }
    {
      import.meta.env.PROD && (
        <>
          <script is:inline>
            window.goatcounter = {
              endpoint: 'https://yaoderek.goatcounter.com/count',
            };
          </script>
          <script async src={`${base}/_metrics.js`} is:inline></script>
        </>
      )
    }
  </head>
  <body>
    <Desktop
      client:only="svelte"
      tree={tree}
      initialPath={initialPath}
      showResume={showResume}
      notFound={notFound}
      wallpaperUrl={wallpaper.src}
      dockIcons={dockIcons}
    />
    <!-- The page's content as plain HTML, in the document rather than in
         <noscript>: crawlers that don't run JS (GPTBot, ClaudeBot,
         PerplexityBot) and text extractors that strip <noscript> read this.
         The .js class hides it once the desktop takes over, which renders
         the same content in its windows. -->
    <main class="static-content">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    padding: 0;
    height: 100%;
    width: 100%;
    overflow: hidden;
  }

  /* Without JS there's no desktop, just the static page, so let it scroll. */
  html:not(.js),
  html:not(.js) body {
    overflow: auto;
    height: auto;
  }

  .js .static-content {
    display: none;
  }

  /* The desktop island replaces the viewport when JS runs; the static
     content is the real crawlable / no-JS page. */
  .static-content {
    display: block;
    max-width: 44rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
    overflow: auto;
    height: auto;
    font-family:
      ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.6;
    color: #1d1d1f;
  }

  .static-content img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1rem 0;
  }

  .static-content a {
    color: #0066cc;
  }
</style>
