---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import OsPage from '../../layouts/OsPage.astro';

const life = await getCollection('life');
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<OsPage
  initialPath="/life"
  title="Life — Derek Yao"
  description="Photos and everyday moments from Derek Yao."
>
  <h1>Life</h1>
  <p><a href={`${base}/`}>← derek's mac</a></p>
  <div class="grid">
    {life.map((photo) => (
      <figure>
        <a href={`${base}/life/${photo.data.id}`}>
          <Image
            src={photo.data.image}
            alt={photo.data.title}
            width={800}
          />
        </a>
        <figcaption>{photo.data.title}</figcaption>
      </figure>
    ))}
  </div>
</OsPage>

<style is:global>
  .noscript-content .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
  }
  .noscript-content figure {
    margin: 0;
  }
  .noscript-content figcaption {
    font-size: 0.85rem;
    color: #6e6e73;
    margin-top: 0.25rem;
  }
</style>
