---
// Redirect stubs for the old project-site URLs (yaoderek.github.io/personal/…)
// after the move to the domain root. One instant meta-refresh page per old
// route, each pointing canonical at its new home. Google reads an instant
// refresh as a permanent redirect and moves the old URL's links to the new
// one. No noindex: on a redirect it's a conflicting signal, and Search Console
// files the old URLs under "Excluded by 'noindex' tag" instead of "Page with
// redirect".
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const [writing, projects, art] = await Promise.all([
    getCollection('writing'),
    getCollection('projects'),
    getCollection('art'),
  ]);
  const slugs = [
    undefined,
    'writing',
    'projects',
    'art',
    'life',
    ...writing.map((e) => `writing/${e.id}`),
    ...projects.map((e) => `projects/${e.id}`),
    ...art.map((e) => `art/${e.id}`),
  ];
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const target = new URL(slug ? `/${slug}/` : '/', Astro.site).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
  </head>
  <body>
    <p>This page moved to <a href={target}>{target}</a>.</p>
  </body>
</html>
