---
import { getCollection } from 'astro:content';
import OsPage from '../../layouts/OsPage.astro';
import { formatMonthRange } from '../../lib/os/format';
import { personRef } from '../../lib/seo';

export async function getStaticPaths() {
  const roles = await getCollection('experience');
  return roles.map((entry) => ({
    params: { id: entry.data.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const iso = (date: Date) => date.toISOString().slice(0, 10);
const startIso = iso(data.start);
const endIso = data.end ? iso(data.end) : undefined;
const when = formatMonthRange(startIso, endIso);
const description = `${data.role} at ${data.org}, ${when}.`;

const jsonLd = {
  '@type': 'OrganizationRole',
  roleName: data.role,
  startDate: startIso,
  ...(endIso ? { endDate: endIso } : {}),
  description,
  member: personRef(Astro.site),
};
---

<OsPage
  initialPath={`/experience/${data.id}`}
  title={`${data.org} — Derek Yao`}
  description={description}
  jsonLd={jsonLd}
>
  <article>
    <p><a href={`${base}/experience`}>← experience</a></p>
    <h1>{data.org}</h1>
    <p>{data.role}{data.note ? ` — ${data.note}` : ''}</p>
    <p>
      <time datetime={startIso}>{when}</time>
    </p>
    <ul>
      {data.highlights.map((line) => <li>{line}</li>)}
    </ul>
  </article>
</OsPage>
